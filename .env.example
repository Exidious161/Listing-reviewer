# At least one of these two is optional; without either, the app runs in offline "mock" mode
# (rule-based reviewer). If both are set, Gemini is used first (its free tier makes it the
# more likely one to actually be funded).
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite
GEMINI_MODEL=

ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5
ANTHROPIC_MODEL=

# Storage is a libsql URL. Without either of the below, it defaults to a local file
# (./data/app.db, or /tmp on Vercel -- ephemeral there, see README). For a host with no
# persistent disk (Vercel, most serverless platforms), set TURSO_DATABASE_URL +
# TURSO_AUTH_TOKEN instead: a free, always-on, SQLite-compatible hosted database
# (turso.tech), so data survives across serverless instances and cold starts.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional. Only used if the two above are not set.
DATABASE_PATH=
